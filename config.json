{
  "windowTitle": "Kerwin's Domain Chat",
  "startupOptions": {
    "server": "irc.libera.chat",
    "port": 6697,
    "tls": true,
    "channel": "#darkdomain",
    "nick": "Kerwin_Guest",
    "username": "kerwie",
    "realname": "Kerwin's Domain User"
  },
  "showAutocomplete": true,
  "allowThemeSwitching": true,
  "theme": "Default",
  "themes": [
    { "name": "Default", "url": "static/themes/default" },
    { "name": "Dark", "url": "static/themes/dark" },
    { "name": "Relaxed", "url": "static/themes/relaxed" }
